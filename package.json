{
  "name": "local-workflow-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server/main.ts",
    "start": "node --import tsx src/server/main.ts",
    "worker": "node --import tsx src/server/main.ts --worker-only",
    "seed": "node --import tsx src/scripts/seed-demo.ts",
    "build": "vite build",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
